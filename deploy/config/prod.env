VARDEN_ENV=prod
VARDEN_HOST=0.0.0.0
VARDEN_PORT=8000
VARDEN_DB_PATH=/data/varden.db
VARDEN_AUTH_DB_PATH=/data/varden_auth.db
VARDEN_POLICY_FILE=/config/policy.json
# REQUIRED: set a random value of 32+ characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Startup refuses the placeholder outside env=dev.
VARDEN_SIGNING_SECRET=change-this-in-production
# Optional: seed a first admin API key (32+ chars). Or run `varden keys create --role admin` against the auth DB.
# VARDEN_BOOTSTRAP_ADMIN_API_KEY=
VARDEN_PUBLIC_BASE_URL=http://localhost:8000
VARDEN_ENABLE_DEV_BOOTSTRAP=false
VARDEN_RATE_LIMIT_PER_MINUTE=120
